# ============================================
# CFR-SITE — Шаблон переменных окружения
# ============================================
#
# ИНСТРУКЦИЯ ПО УСТАНОВКЕ:
#
# 1. Скопируйте этот файл:
#    cp .env.example .env.production
#
# 2. Сгенерируйте секретные ключи:
#    export JWT_SECRET=$(openssl rand -base64 32)
#    export ADMIN_API_KEY=$(openssl rand -base64 32)
#    export PG_PASSWORD=$(openssl rand -base64 16)
#
# 3. Вставьте значения в .env.production
#    (см. комментарии ниже)
#
# 4. Проверьте, что файл НЕ закоммичен:
#    git status .env.production
#    (должно быть: untracked, что нормально — он в .gitignore)
#
# ============================================

# ---------- Режим работы с данными ----------
# json     — данные хранятся в db.json (по умолчанию, быстро)
# postgres — данные хранятся в PostgreSQL (надёжнее, масштабируемее)
DB_MODE=json

# ---------- Подключение к PostgreSQL (при DB_MODE=postgres) ----------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=cfr_site
PG_USER=cfr
PG_PASSWORD=

# ---------- JWT (для Личного кабинета) ----------
# Минимум 32 символа, случайный набор
# Генерация: openssl rand -base64 32
JWT_SECRET=

# ---------- Admin API (защита админ-маршрутов) ----------
# Базовая авторизация: admin:<ADMIN_API_KEY>
# Генерация: openssl rand -base64 32
ADMIN_API_KEY=

# ---------- Email (Nodemailer) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ---------- Yandex Disk (автозагрузка) ----------
YANDEX_DISK_FOLDER_PATH=
YANDEX_DISK_OAUTH_TOKEN=

# ---------- Сервер ----------
NODE_ENV=production
PORT=3000
