# Next.js build output
.next/
out/
dist/

# Runtime uploads (старая Next.js-версия в trash/)
/uploads/

# Node
node_modules/

# Motion picture files
*.mov
*.mp4

# Документация
documentation/deploy.md

# Данные БД (JSON-файлы)
# db.json — источник данных статического сайта, коммитится (176 КБ)
_db.json
data/*.json
backups/

# Бэкапы db.json (локальные)
db.json.backup*

.db-mode.json
.db-mode

# TypeScript build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Окружение (реальные секреты — НЕ коммитим)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging

# Но шаблоны конфигов — коммитим
!.env.production.example

# Сессии админки (файл + память, перезапуск PM2 — токен в localStorage всё ещё валиден)
.admin-sessions.json

# Сменённый пароль админки (S126): sha256+salt, задаётся в «Главных данных».
# Вне репозитория — приоритет выше, чем ADMIN_PASSWORD из окружения.
.admin-password.json

!.env.example

# Данные с Яндекс.Диска (гигабайты, не коммитим) — содержимое
static/data/*
# ИСКЛЮЧЕНИЕ: сжатые листы расписания и цен (показываются на сайте)
!static/data/1.jpg
!static/data/2.jpg
!static/data/price-2026-10.jpg
# ИСКЛЮЧЕНИЕ: исходные прайсы (.doc) — их парсит scripts/parse-price.mjs (S115)
!static/data/prices/
!static/data/prices/*

# Старая версия Next.js — на антресолях (не включать в деплой)
trash/

# Свалка тикетов и мультитикетов
tickets/trash/
