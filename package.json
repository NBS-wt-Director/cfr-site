{
  "name": "cfr-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3011",
    "build": "next build --webpack",
    "start": "next start --no-turbopack -p 3000",
    "preview": "npm run build && npm start",
    "ssl": "./deploy/ssl-selfsigned.sh",
    "pm2:start": "pm2 start deploy/ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs cfrsite --lines 50",
    "analyze": "node scripts/analyze.js",
    "analyze:fix": "node scripts/analyze.js --verbose",
    "analyze:dev": "node scripts/analyze.js --dev",
    "add-path-comments": "node add-path-comments.js",
    "deploy": "node deploy.mjs",
    "add-path-comments:watch": "nodemon --watch . --ext js,ts,jsx,tsx,mjs,cjs,vue,svelte --exec \"npm run add-path-comments\"",
    "init-db": "node scripts/init-db.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.11.0",
    "markdown-it": "^15.0.0",
    "next": "^16.1.6",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.33",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.0.1",
    "eslint-config-next": "^0.2.4",
    "glob": "^13.0.6",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  },
  "description": "Полнофункциональный веб-сайт спортивного центра с системой управления контентом (CMS).",
  "main": "add-path-comments.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NBS-wt-Director/cfr-site.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NBS-wt-Director/cfr-site/issues"
  },
  "homepage": "https://github.com/NBS-wt-Director/cfr-site#readme"
}
